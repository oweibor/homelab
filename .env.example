# .env.example — Agent Factory Platform
# Copy this file to .env and fill in your values
# Most values are auto-generated by setup.sh

# ─── System ─────────────────────────────────────────────────────
PUID=1000
PGID=1000
ACTUAL_USER=your_username_here
TZ=Etc/UTC

# ─── OpenClaw Agent ─────────────────────────────────────────────
OPENCLAW_TOKEN=changeme_generate_random_hex
TRUST_MODE=supervised
OPENCLAW_KILO_ENABLED=true

# ─── Kilo Pipeline ──────────────────────────────────────────────
HARDWARE_PROFILE=n100_like
QDRANT_HOST=http://qdrant:6333
KILO_PIPELINE_PORT=3100

# ─── Ollama Models ──────────────────────────────────────────────
OLLAMA_MODEL=llama3.2:1b llama3.2:3b qwen2.5-coder:3b
OLLAMA_DEFAULT_MODEL=qwen2.5-coder:3b
OLLAMA_GENERAL_MODEL=llama3.2:3b
OLLAMA_QUICK_MODEL=llama3.2:1b
OLLAMA_MEM_LIMIT=4g

# ─── Crawl4AI Research Pipeline ─────────────────────────────────
CRAWL4AI_MAX_CONCURRENT=5
CRAWL4AI_API_TOKEN=
CRAWL4AI_MEMORY_LIMIT=800m

# ─── Autonomy & Notifications ──────────────────────────────────
# Webhook URL for task completion notifications (Slack/Telegram/email)
NOTIFY_WEBHOOK=
