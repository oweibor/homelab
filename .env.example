# .env.example - Example environment configuration for homelab
# Copy this file to .env and fill in your values

# User and Group IDs (auto-generated by setup.sh)
PUID=1000
PGID=1000
RENDER_GID=109

# ACTUAL_USER: Required for Nextcloud data paths. Auto-set by setup.sh.
ACTUAL_USER=your_username_here

# Timezone (e.g., America/New_York, Europe/London, Africa/Lagos)
TZ=Etc/UTC

# Samba Credentials
SAMBA_USER=your_username
SAMBA_PASS=changeme_strong_password_here

# Ollama Model (space-separated list)
OLLAMA_MODEL=llama3.2:1b llama3.2:3b qwen2.5-coder:3b

# Plex Claim Token (get from https://www.plex.tv/claim/ - valid for 4 minutes)
PLEX_CLAIM=


# Antigravity VNC Password (simple 8-char alphanumeric)
ANTIGRAVITY_VNC_PASSWORD=homelab1

# OpenClaw Gateway Token (auto-generated by setup.sh)
OPENCLAW_TOKEN=changeme_generate_random_hex

# Grafana Admin Password (default: admin)
GF_ADMIN_PASSWORD=changeme_strong_password_here

# ONLYOFFICE JWT Secret (auto-generated by setup.sh)
ONLYOFFICE_JWT_SECRET=changeme_generate_random_secret

# Nextcloud Admin Password (auto-generated by setup.sh)
NEXTCLOUD_ADMIN_PASSWORD=changeme_strong_password_here

# Homepage widget tokens (obtain post-install)
PLEX_TOKEN=                    # Settings → Troubleshooting → Get Token
JELLYFIN_API_KEY=              # Dashboard → Admin → API Keys → New

# Kilo CLI API Key (for AI orchestration)
KILO_API_KEY=
