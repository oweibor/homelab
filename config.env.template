# Homelab Configuration Template
# Rename this file to 'config.env' in the same directory as setup.sh to pre-load values.
# This file is also written by the onboarding wizard - do not edit manually if using onboard.sh

# =============================================================================
# TIMEZONE & NETWORK
# =============================================================================

# Timezone (e.g. America/New_York)
# Leave empty to auto-detect from system
TIMEZONE=

# Network Interface Override
# Leave empty to auto-detect
INTERFACE=

# =============================================================================
# USER & PERMISSIONS
# =============================================================================

# User ID (run 'id' command to find your UID)
PUID=1000

# Group ID (run 'id' command to find your GID)
PGID=1000

# Render Group ID for GPU/VAAPI access (run 'getent group render | cut -d: -f3')
# Common values: 44 (Ubuntu), 966 (CentOS/RHEL), leave empty if not needed
RENDER_GID=

# =============================================================================
# HARDWARE CLASSIFICATION (written by onboarding wizard)
# =============================================================================

# Hardware profile for AI pipeline constraints:
# n100_like (Intel N95/N97/N100/N200), n305 (Intel N305 8-core), celeron,
# core_i3, core_i5, core_i7, amd_low, amd_mid, amd_high,
# arm64_rpi5, arm64_server, arm64_rk3588,
# nvidia_small (4GB), nvidia_medium (8GB), nvidia_large (12-24GB), apple_silicon
HARDWARE_PROFILE=

# Hardware speed classification: INSUFFICIENT, CPU_MARGINAL, IGPU_OK, GPU_GOOD, GPU_GREAT
SPEED_CLASS=

# Resource tier: MINIMAL, LOW, MID, HIGH, ULTRA
RESOURCE_TIER=

# =============================================================================
# GPU & STREAMING HARDWARE (written by onboarding wizard)
# =============================================================================

# GPU VRAM in GB (detected automatically)
GPU_VRAM_GB=0

# Encoder type: quicksync, vaapi, nvenc, amf, videotoolbox, none
ENCODER_TYPE=none

# Plex hardware acceleration: auto, nv, qs, vaapi, disabled
PLEX_HW_ACCEL=disabled

# Jellyfin hardware acceleration: QSV, VAAPI, NVIDIA, AMD, Auto, None
JELLYFIN_HW_ACCEL=None

# Enable hardware transcoding in Plex (1=yes, 0=no)
PLEX_TRANSCODE_HW=0

# Enable hardware transcoding in Jellyfin (1=yes, 0=no)
JELLYFIN_TRANSCODE_HW=0

# =============================================================================
# OLLAMA MODELS (written by onboarding wizard)
# =============================================================================

# Model for coding/architect/orchestrator roles
OLLAMA_DEFAULT_MODEL=qwen2.5-coder:3b

# Model for planning/reasoning/general tasks
OLLAMA_GENERAL_MODEL=llama3.2:3b

# Model for delegation/fast/quick tasks
OLLAMA_QUICK_MODEL=llama3.2:1b

# Combined model list for setup.sh pull loop (space-separated)
OLLAMA_MODEL=qwen2.5-coder:3b llama3.2:3b llama3.2:1b

# =============================================================================
# OLLAMA PERFORMANCE TUNING (written by onboarding wizard)
# =============================================================================

# CPU threads - formula: 75% of physical cores, max 12
OLLAMA_NUM_THREADS=4

# Flash attention - 0 for CPU, 1 for GPU/Metal
OLLAMA_FLASH_ATTENTION=0

# KV cache type - q8_0 recommended
OLLAMA_KV_CACHE_TYPE=q8_0

# Parallel requests per model
OLLAMA_NUM_PARALLEL=1

# Max models loaded at once
OLLAMA_MAX_LOADED_MODELS=1

# GPU layers - 999 for full offload, 0 for CPU-only
OLLAMA_NUM_GPU=0

# Keep model warm for N minutes after use
OLLAMA_KEEP_ALIVE=5m

# Enable Metal on Apple Silicon (1 = enabled)
OLLAMA_METAL=0

# Context windows per role
OLLAMA_CTX_CODING=8192
OLLAMA_CTX_GENERAL=4096
OLLAMA_CTX_QUICK=2048

# =============================================================================
# AI MODE & TRUST (written by onboarding wizard)
# =============================================================================

# AI mode: local, hybrid, cloud-primary
AI_MODE=local

# Kilo trust mode: supervised, graduated, autonomous
TRUST_MODE=supervised

# =============================================================================
# CRAWL4AI WEB SCRAPER (OpenClaw + LangGraph + Crawl4AI)
# =============================================================================

# Crawl4AI service URL
CRAWL4AI_URL=http://crawl4ai:8000

# VS Code Server password (leave empty to generate randomly)
VSCOD_E_PASSWORD=

# Crawl4AI API token (optional, leave empty for local)
CRAWL4AI_API_TOKEN=

# Anti-bot mode: standard, magic, stealth
CRAWL4AI_MODE=magic

# Max concurrent requests (hardware-aware, auto-configured)
CRAWL4AI_MAX_CONCURRENT=

# Request timeout in milliseconds
CRAWL4AI_TIMEOUT=30000

# Memory limit for Crawl4AI container (supports: 512m, 1g, 2g, 4g, 8g)
CRAWL4AI_MEMORY_LIMIT=2g

# Basic auth for Crawl4AI web UI (htpasswd format, leave empty to disable)
# Format: :admin:$apr1$xxxx$xxxx (htpasswd -nb method)
# Generate with: htpasswd -nb admin yourpassword | sed 's/^/:/'
# Example output: :admin:$apr1$H6uskkkW$IgXLP6ewTrSuBk76q3ibH/
CRAWL4AI_BASICAUTH=

# Enable proxy rotation (true/false)
CRAWL4AI_PROXY_ENABLED=false

# Proxy list (comma-separated URLs)
CRAWL4AI_PROXY_LIST=

# Qdrant collection for scraped content
SCRAPE_QDRANT_COLLECTION=scraped_content

# Hardware profile for scraper (inherits from HARDWARE_PROFILE if empty)
SCRAPE_HARDWARE_PROFILE=

# =============================================================================
# ANTI-DETECTION STACK (Tor + I2P + Fingerprint + IPv6 + WiFi Rotation)
# =============================================================================

# --- Tor Configuration ---
# Enable Tor SOCKS5 proxy for IP rotation (true/false)
ENABLE_TOR=false

# Tor service host and ports
TOR_HOST=tor
TOR_PORT=9050
TOR_CONTROL_PORT=9051

# Tor control port password (used by hybridNetworkManager)
# SECURITY: DO NOT use plaintext passwords in production.
# 1. BEST: Use Docker Secrets with TOR_PASSWORD_FILE=./.secrets/tor_password
# 2. REQUIRED: Set TOR_PASSWORD_HASH for the torrc file.
# Generate hash with: docker run --rm dperson/torproxy tor --hash-password "your_password"
TOR_PASSWORD_FILE=./.secrets/tor_password
# Tor control port password hash (for torrc HashedControlPassword)
# Generate with: docker run --rm dperson/torproxy tor --hash-password "your_password"
TOR_PASSWORD_HASH=16:YOUR_HASHED_PASSWORD_HERE

# --- I2P Configuration ---
# Enable I2P anonymous network (true/false)
ENABLE_I2P=false

# I2P service host and ports
I2P_HOST=i2p
I2P_SAM_PORT=7656
I2P_HTTP_PORT=7657

# --- Fingerprint Randomization ---
# Enable browser fingerprint randomization (true/false, default: true)
ENABLE_FINGERPRINT=true

# Fingerprint pool size (auto-configured per hardware profile if empty)
FINGERPRINT_POOL_SIZE=

# Randomize fingerprint per request (true/false, auto-configured per profile)
RANDOMIZE_FINGERPRINT=

# --- IPv6 Configuration ---
# Enable IPv6 connections (true/false, default: true)
ENABLE_IPV6=true

# Prefer IPv6 over IPv4 when available (true/false)
PREFER_IPV6=

# --- WiFi / Tether IP Rotation ---
# Enable WiFi/tether rotation for IP changes (true/false, default: true)
ENABLE_WIFI_ROTATION=true

# --- Ultimate Fallback Chain ---
# Enable fallback chain: fingerprint → IPv6 → Tor → I2P → WiFi (default: true)
ENABLE_FALLBACK=true

# Max retries before giving up (auto-configured per profile if empty)
FALLBACK_MAX_RETRIES=

# Delay between retries in ms
FALLBACK_RETRY_DELAY=1000

# =============================================================================
# NEXTCLOUD CSV EXPORT
# =============================================================================

# Path to Nextcloud data directory
NEXTCLOUD_DATA_PATH=/var/www/html/data

# Nextcloud admin user (for files path)
NEXTCLOUD_ADMIN_USER=admin

# =============================================================================
# SERVICE CREDENTIALS (generated by setup.sh Step 7)
# =============================================================================

# Plex Claim Token
# Get one at https://www.plex.tv/claim/ (valid for 4 minutes)
PLEX_CLAIM=

# Grafana Admin Password (default: admin if empty)
GF_ADMIN_PASSWORD=

# Kilo CLI API Key (for AI orchestration, optional)
KILO_API_KEY=

# =============================================================================
# NEXTCLOUD
# =============================================================================

# Nextcloud data path (relative to homelab directory)
NEXTCLOUD_DATA_PATH=./nextcloud/data

# =============================================================================
# LEGACY VARIABLES (for backward compatibility)
# =============================================================================

# These variables are kept for compatibility but OLLAMA_* versions are preferred
# MODEL_CODING is deprecated - use OLLAMA_DEFAULT_MODEL
MODEL_CODING=qwen2.5-coder:3b
# MODEL_GENERAL is deprecated - use OLLAMA_GENERAL_MODEL
MODEL_GENERAL=llama3.2:3b
# MODEL_QUICK is deprecated - use OLLAMA_QUICK_MODEL
MODEL_QUICK=llama3.2:1b
